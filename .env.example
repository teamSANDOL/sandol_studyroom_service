DEBUG=false
LOG_LEVEL=INFO
TIMEZONE=Asia/Seoul
API_DOCS_ENABLED=true
CORS_ALLOWED_ORIGINS=["http://localhost:3080"]
API_PORT=8000
TAG=latest

POSTGRES_DB=studyroom_service
POSTGRES_USER=studyroom
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_HOST=studyroom-db
POSTGRES_PORT=5432
# DATABASE_URL이 비어 있으면 POSTGRES_*로 연결 정보를 만든다.
DATABASE_URL=

REDIS_URL=redis://studyroom-redis:6379/0
REDIS_KEY_PREFIX=sandol:studyroom:v1
LIVE_CACHE_TTL_SECONDS=20
GUIDE_CACHE_TTL_SECONDS=300

SCHOOL_BASE_URL=http://smart.tukorea.ac.kr
LIBRARY_BASE_URL=https://library.tukorea.ac.kr
SCHOOL_REQUEST_TIMEOUT_SECONDS=10
GUIDE_REQUEST_TIMEOUT_SECONDS=12
COLLECTION_INTERVAL_SECONDS=60
HISTORY_RETENTION_DAYS=90
COLLECTION_STALE_AFTER_SECONDS=180
