# 디버그 모드. 참이면 FastAPI가 상세 오류를 노출한다. 운영에서는 false 다.
DEBUG=false
# 로그 수준. DEBUG, INFO, WARNING, ERROR, CRITICAL 중 하나다.
LOG_LEVEL=INFO
# 서비스 기준 시간대다. Asia/Seoul 로 고정한다.
TIMEZONE=Asia/Seoul
# 참이면 /studyroom/docs 와 /studyroom/openapi.json 을 제공한다.
API_DOCS_ENABLED=true
# 1 이면 개발용 프론트엔드(/studyroom/ 과 static)를 제공하고, 0 이면 404 로 막는다. API 와 health 는 모드와 무관하게 열려 있다.
DEVELOPMENT_FRONTEND_MODE=0
# CORS 를 허용할 출처 목록이다. JSON 배열로 적는다. 비우면 어떤 출처도 허용하지 않는다.
CORS_ALLOWED_ORIGINS=["http://localhost:3080"]
# Compose 가 host 에 노출하는 API 포트다.
API_PORT=8000
# 서비스 이미지 태그다.
TAG=latest

# PostgreSQL 데이터베이스 이름이다.
POSTGRES_DB=studyroom_service
# PostgreSQL 사용자다.
POSTGRES_USER=studyroom
# PostgreSQL 비밀번호다. 실제 값으로 바꾼다. 비우면 시작하지 않는다.
POSTGRES_PASSWORD=change-this-db-password
# PostgreSQL host 다. Compose 내부 서비스 이름이다.
POSTGRES_HOST=studyroom-db
# PostgreSQL 포트다.
POSTGRES_PORT=5432
# 연결 URL 을 직접 지정한다. 비어 있으면 위 POSTGRES_* 로 URL 을 만든다. 지정하면 POSTGRES_* 보다 우선한다.
DATABASE_URL=

# Redis 연결 URL 이다. redis:// 또는 rediss:// 로 시작한다.
REDIS_URL=redis://studyroom-redis:6379/0
# Redis key 앞에 붙이는 접두사다. 배포 단위를 구분한다.
REDIS_KEY_PREFIX=sandol:studyroom:v1
# 열람실 현재 현황을 cache 하는 시간(초)이다. 이 시간 안의 요청은 학교에 다시 묻지 않는다.
LIVE_CACHE_TTL_SECONDS=20
# 공식 도서관 안내를 cache 하는 시간(초)이다.
GUIDE_CACHE_TTL_SECONDS=300

# 학교 좌석 시스템 주소다.
SCHOOL_BASE_URL=http://smart.tukorea.ac.kr
# 공식 도서관 안내 사이트 주소다.
LIBRARY_BASE_URL=https://library.tukorea.ac.kr
# 학교 좌석 시스템 요청 timeout(초)이다.
SCHOOL_REQUEST_TIMEOUT_SECONDS=3
# 공식 도서관 안내 요청 timeout(초)이다.
GUIDE_REQUEST_TIMEOUT_SECONDS=12
# 1 이면 주기 수집 태스크를 띄운다. DB 없이 띄울 때는 0 으로 끈다.
COLLECTION_ENABLED=1
# 학교 좌석 시스템을 수집해 DB에 적재하는 주기(분)다.
COLLECTION_INTERVAL_MINUTES=3
# 혼잡도 기록 보관 기간(일)이다. 이보다 오래된 기록은 정리 대상이다.
HISTORY_RETENTION_DAYS=90
# 마지막 수집이 이 시간(분)보다 오래되면 수집 지연으로 본다. 주기보다 커야 한다.
COLLECTION_STALE_AFTER_MINUTES=7
